{
  "extraKnownMarketplaces": {
    "story-to-ship": {
      "source": {
        "source": "github",
        "repo": "jpegthedev/story-to-ship"
      }
    }
  },
  "enabledPlugins": {
    "story-to-ship@story-to-ship": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-message.sh"
          }
        ]
      }
    ]
  }
}
